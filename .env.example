# Neon Auth (enable Neon Auth in the Neon project and enable Google provider)
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
NEON_AUTH_COOKIE_SECRET=

# Neon PostgreSQL pooled connection string from Vercel/Neon
DATABASE_URL=

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary - upload signatures must be generated server-side
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment providers - deliberately not wired until provider diligence is complete
PAYMENT_PROVIDER=disabled
BACHS_API_BASE_URL=
BACHS_API_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Optional observability
SENTRY_DSN=
